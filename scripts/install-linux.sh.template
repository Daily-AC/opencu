#!/bin/sh
# Install OpenCU for the current user on x86_64 Linux, without root.
# The archive is refused unless its SHA-256 matches the value below. The
# manifest is written last; hosts discover OpenCU through it.
set -eu
version='@@VERSION@@'
expected='@@SHA256@@'
url='@@ASSET_URL@@'
dir="${OPENCU_HOME:-${XDG_DATA_HOME:-$HOME/.local/share}/opencu}"

[ "$(uname -s)" = Linux ] && [ "$(uname -m)" = x86_64 ] || {
    echo "OpenCU $version for Linux supports x86_64 only (this is $(uname -s) $(uname -m)). Nothing was installed." >&2; exit 1; }
# The bundled Node.js needs glibc.
if [ -e /lib/ld-musl-x86_64.so.1 ] && [ ! -e /lib64/ld-linux-x86-64.so.2 ]; then
    echo "OpenCU $version needs a glibc Linux; this system uses musl (for example Alpine). Nothing was installed." >&2; exit 1
fi
# Only ever replace an earlier OpenCU install.
if [ -e "$dir" ] && [ ! -e "$dir/opencu.json" ] && [ ! -e "$dir/bin/opencu" ]; then
    echo "$dir exists and is not an OpenCU install. Choose another OPENCU_HOME. Nothing was installed." >&2; exit 1
fi
parent=$(dirname -- "$dir")
mkdir -p "$parent"
work=$(mktemp -d "$parent/.opencu-install.XXXXXX")
trap 'rm -rf "$work"' EXIT INT TERM
if [ -n "${OPENCU_LOCAL_ARCHIVE:-}" ]; then
    cp -- "$OPENCU_LOCAL_ARCHIVE" "$work/opencu.tar.gz"
elif command -v curl >/dev/null 2>&1; then
    curl -fsSL "$url" -o "$work/opencu.tar.gz"
else
    wget -qO "$work/opencu.tar.gz" "$url"
fi
actual=$(sha256sum "$work/opencu.tar.gz" | cut -d ' ' -f 1)
if [ "$actual" != "$expected" ]; then
    echo "SHA-256 mismatch: expected $expected, got $actual. Nothing was installed." >&2; exit 1
fi
mkdir "$work/opencu"
tar -xzf "$work/opencu.tar.gz" -C "$work/opencu" --no-same-owner
rm -rf "$dir.old"
if [ -e "$dir" ]; then mv -- "$dir" "$dir.old"; fi
mv -- "$work/opencu" "$dir"
rm -rf "$dir.old"
node="$dir/.dependencies/node/bin/node"
"$node" -e 'const [version, command, server] = process.argv.slice(1);
process.stdout.write(JSON.stringify({ name: "opencu", version, platform: "linux", mcp: { command, args: [server] } }) + "\n");' \
    "$version" "$node" "$dir/src/server.mjs" > "$dir/opencu.json.tmp"
mv -- "$dir/opencu.json.tmp" "$dir/opencu.json"
echo "Installed OpenCU $version in $dir"
echo "Manifest: $dir/opencu.json"
echo "MCP command: $dir/bin/opencu"
if [ -n "${DISPLAY:-}" ]; then "$dir/bin/opencu" doctor || true; else echo 'Set DISPLAY and run: '"$dir"'/bin/opencu doctor'; fi
